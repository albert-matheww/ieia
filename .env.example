# =============================================================================
# IEIA — environment configuration
# Copy to .env  ( cp .env.example .env )  and adjust. .env is git-ignored.
# Every secret the system needs is listed here — nothing is hard-coded.
# =============================================================================

# ---- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=ieia
POSTGRES_USER=ieia
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
# JDBC URL the backend uses (compose network host = service name "db")
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/ieia

# ---- Backend (Spring Boot) ----------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=docker
# JWT signing secret — MUST be >= 32 bytes / 256 bits of entropy in real use
JWT_SECRET=change-me-please-use-a-long-random-256-bit-secret-string
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# CORS: the browser origin allowed to call the API
FRONTEND_ORIGIN=http://localhost:5173
# Seed the demo dataset on startup (dev/demo only). Set false for a clean DB.
IEIA_SEED_DEMO=true

# ---- ML service (FastAPI) ---------------------------------------------------
ML_SERVICE_URL=http://ml-service:8000
# Shared secret for backend -> ml-service calls (Bearer token on the internal network)
ML_SERVICE_TOKEN=change-me-internal-ml-token
ML_SERVICE_TIMEOUT_MS=8000
ML_RANDOM_SEED=42

# ---- LLM abstraction ------------------------------------------------------
# Provider: MOCK | OPENAI | ANTHROPIC | OLLAMA
# MOCK is the default — the whole project runs with NO API key.
IEIA_LLM_PROVIDER=MOCK
IEIA_LLM_MODEL=mock-analyst-v1
IEIA_LLM_TIMEOUT_MS=20000
IEIA_LLM_MAX_TOKENS=800

# OpenAI (only read when IEIA_LLM_PROVIDER=OPENAI)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (only read when IEIA_LLM_PROVIDER=ANTHROPIC)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Ollama (only read when IEIA_LLM_PROVIDER=OLLAMA) — local, no key
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---- Frontend (build-time) ------------------------------------------------
# Base URL the SPA calls. "/api" (same origin) is right for BOTH:
#   * docker compose — nginx in the frontend container proxies /api -> backend:8080
#   * local `npm run dev` — the Vite dev server proxies /api -> localhost:8080
# Only set an absolute URL if you serve the SPA from a different origin than the API.
VITE_API_BASE_URL=/api

# ---- Reports --------------------------------------------------------------
REPORT_OUTPUT_DIR=/data/reports
